# Alag Telegram bot (BotFather se naya token). BIMBO wala mat dalna.
SC_BOT_TOKEN=123456:ABC...
SC_API_ID=12345678
SC_API_HASH=your_api_hash
SC_OWNER_ID=0
# space-separated extra admins / allowed users
SC_ADMIN_IDS=
SC_ALLOWED_USERS=
# true = koi bhi user record kar sake (bandwidth heavy)
SC_ALLOW_ALL=false

# optional
SC_DOWNLOAD_DIR=
STRIPCHAT_KEY_FILE=
SC_MAX_REC=3
SC_UNTIL_STOP_CAP_MIN=180
SC_LOG_CHANNEL=0
PORT=8080

# optional override keys (warna keys.txt)
# STRIPCHAT_PKEY=
# STRIPCHAT_PDKEY=
